HKIPO_HOST=127.0.0.1
HKIPO_PORT=8000
HKIPO_DATA_ROOT=/home/ma-user/work/data
HKIPO_RUNTIME_ROOT=/home/ma-user/work/IPO_Sentinel_Platform/hk_ipo_risk_system/runtime
HKIPO_MAX_PAGES=0
HKIPO_MAX_EVIDENCE_PER_ANALYSIS=12000
HKIPO_AGENT_ROOM_AUTO_START=1
HKIPO_DEFAULT_LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Doubao / Volcengine Ark
# chat/completions 必须使用方舟 API Key（DOUBAO_API_KEY）。
# AK/SK 不能直接作为 Bearer，单独配置时会判定为未就绪并回退。
DOUBAO_API_KEY=
DOUBAO_ACCESS_KEY_ID=
DOUBAO_SECRET_ACCESS_KEY=
DOUBAO_MODEL=doubao-pro-32k
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Thin RAG API (IPO-RAG). Keep eval repo offline; production uses index + HTTP API.
HKIPO_RAG_ENABLED=1
HKIPO_RAG_BASE_URL=http://127.0.0.1:8000
HKIPO_RAG_TIMEOUT_S=45
HKIPO_RAG_TOP_K=8
HKIPO_RAG_RANKING_PROFILE=hge
HKIPO_WORKING_EVIDENCE_LIMIT=240

# auto: MinerU store if present, else PyMuPDF. mineru/pymupdf force a backend.
HKIPO_PARSER_BACKEND=auto
HKIPO_MINERU_EVIDENCE_ROOT=/home/ma-user/work/IPO_Sentinel_Platform/ipo_rag_eval_final/data/evidence
